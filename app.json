{
  "expo": {
    "name": "cue",
    "slug": "cue",
    "version": "1.0.0",
    "scheme": "cue",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/13242deb-ac3a-451f-b603-7afce2755fa7"
    },
    "ios": {
      "bundleIdentifier": "com.billd.cue",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.billd.cue",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-localization",
      "expo-dev-client",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to access your location to show your city and nearby comedy."
        }
      ],
      "expo-router",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "REPLACE_WITH_SENTRY_ORG",
          "project": "REPLACE_WITH_SENTRY_PROJECT"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "13242deb-ac3a-451f-b603-7afce2755fa7"
      }
    },
    "owner": "theobarnes"
  }
}
