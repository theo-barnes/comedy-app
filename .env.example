# Copy this file to .env.local and fill in your values.
# These are exposed to the client bundle — never put secret/service-role keys here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Platform/discovery API base URL. Set either one.
# The app will prefer EXPO_PUBLIC_API_URL and fall back to EXPO_PUBLIC_DISCOVERY_API_URL.
# Simulator: 127.0.0.1 works. Physical iPhone on the same Wi-Fi: use the Mac's LAN IP
# (e.g. http://192.168.x.x:8000) with the backend bound to 0.0.0.0 (backend/scripts/dev.sh default).
# EAS development-device builds use the hosted dev API instead (docs/OPERATOR-TASKS.md, Phase B).
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_DISCOVERY_API_URL=http://127.0.0.1:8000

# Required for Google OAuth (see Todo.txt for setup steps)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id