# Backend local development defaults (copy to backend/.env and adjust as needed)

# Use the unified local platform DB.
DISCOVERY_DATABASE_URL=postgresql://platform:platform@127.0.0.1:54329/platform

# Optional local redis cache.
DISCOVERY_REDIS_URL=redis://127.0.0.1:63790/0

# Demo behavior: allow mid-sized cities (like San Francisco) to return neighbourhood chips immediately.
DISCOVERY_MIN_INVENTORY_FOR_NEIGHBOURHOODS=0
