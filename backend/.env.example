# Backend local development defaults (copy to backend/.env and adjust as needed)

# Use the unified local platform DB.
DISCOVERY_DATABASE_URL=postgresql://platform:platform@127.0.0.1:54329/platform

# Optional local redis cache.
DISCOVERY_REDIS_URL=redis://127.0.0.1:63790/0

# Supabase JWT verification for authenticated /v1 routes.
DISCOVERY_SUPABASE_URL=

# Cloudflare Stream. Leave blank locally to use the in-memory stub provider.
# These are backend-only secrets: never use EXPO_PUBLIC_ names or place them in the mobile env.
DISCOVERY_CLOUDFLARE_ACCOUNT_ID=
DISCOVERY_CLOUDFLARE_API_TOKEN=
DISCOVERY_CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# Video policy. Production defaults: 5 minutes, 500 MiB, 2 active uploads per creator.
DISCOVERY_MAX_VIDEO_DURATION_SECONDS=300
DISCOVERY_MAX_VIDEO_SIZE_BYTES=524288000
DISCOVERY_MAX_ACTIVE_UPLOADS_PER_CREATOR=2

# Optional backend error reporting.
DISCOVERY_SENTRY_DSN=

# Demo behavior: allow mid-sized cities (like San Francisco) to return neighbourhood chips immediately.
DISCOVERY_MIN_INVENTORY_FOR_NEIGHBOURHOODS=0
